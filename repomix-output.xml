<file path="src/pages/Auth/ForgotPasswordPage.jsx">
import { useState } from 'react';
import { Link } from 'react-router-dom';
import { KeyRound } from 'lucide-react';
import PageTransition from '../../components/common/PageTransition';
import { authService } from '../../services/authService';
import { useLanguage } from '../../context/LanguageContext';
import styles from './AuthPages.module.scss';

export default function ForgotPasswordPage() {
  const { lang } = useLanguage();
  const [email, setEmail] = useState('pro@owjify.com');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [resetPayload, setResetPayload] = useState(null);

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setLoading(true);
    try {
      const payload = await authService.requestPasswordReset(email);
      setResetPayload(payload);
    } catch (err) {
      setError(
        err.message === 'USER_NOT_FOUND'
          ? lang === 'fa'
            ? 'حسابی با این ایمیل یافت نشد (می‌توانید از pro@owjify.com استفاده کنید).'
            : 'No account found with this email (try pro@owjify.com).'
          : lang === 'fa'
          ? 'نشانی ایمیل معتبر نیست.'
          : 'Please enter a valid email.'
      );
    } finally {
      setLoading(false);
    }
  };

  return (
    <PageTransition>
      <div className={styles.card}>
        <h2 className={styles.title}>
          {lang === 'fa' ? 'بازیابی رمز عبور' : 'Forgot Password'}
        </h2>
        <p className={styles.subtitle}>
          {lang === 'fa'
            ? 'ایمیل حساب خود را وارد کنید تا لینک بازنشانی ایجاد شود.'
            : 'Enter your registered email to receive a password reset token.'}
        </p>

        {error && <div className={styles.errorAlert}>{error}</div>}

        <form className={styles.form} onSubmit={handleSubmit}>
          <div className={styles.field}>
            <label>{lang === 'fa' ? 'نشانی ایمیل' : 'Email Address'}</label>
            <input
              type="email"
              required
              dir="ltr"
              value={email}
              onChange={(e) => setEmail(e.target.value)}
            />
          </div>

          <button type="submit" disabled={loading} className="owj-btn owj-btn--lime">
            {loading ? <span className="owj-spinner" /> : <KeyRound size={17} />}
            <span>{lang === 'fa' ? 'ارسال لینک بازیابی' : 'Generate Reset Link'}</span>
          </button>
        </form>

        {resetPayload && (
          <div className={styles.devBox}>
            <div style={{ fontWeight: 800, marginBottom: 6 }}>
              {lang === 'fa'
                ? 'لینک شبیه‌سازی ایمیل بازیابی آماده شد:'
                : 'Simulated Password Reset Link Ready:'}
            </div>
            <Link
              to={`/auth/reset-password?token=${encodeURIComponent(resetPayload.token)}`}
              className="owj-btn owj-btn--dark owj-btn--sm"
            >
              {lang === 'fa' ? 'باز کردن فرم تغییر رمز عبور' : 'Open Reset Password Page'}
            </Link>
          </div>
        )}

        <p className={styles.footerNote}>
          <Link to="/auth/login">
            {lang === 'fa' ? 'بازگشت به صفحه ورود' : 'Back to Login'}
          </Link>
        </p>
      </div>
    </PageTransition>
  );
}
</file>

<file path="src/pages/Auth/ResetPasswordPage.jsx">
import { useState } from 'react';
import { Link, useNavigate, useSearchParams } from 'react-router-dom';
import { ShieldCheck } from 'lucide-react';
import PageTransition from '../../components/common/PageTransition';
import PasswordStrength from '../../components/forms/PasswordStrength';
import { authService } from '../../services/authService';
import { useLanguage } from '../../context/LanguageContext';
import { useToast } from '../../context/ToastContext';
import styles from './AuthPages.module.scss';

export default function ResetPasswordPage() {
  const { lang } = useLanguage();
  const { showToast } = useToast();
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();

  const stored = authService.getPendingResetToken();
  const token = searchParams.get('token') || stored?.token || '';

  const [password, setPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  if (!token) {
    return (
      <PageTransition>
        <div className={styles.card} style={{ textAlign: 'center' }}>
          <h2 className={styles.title}>
            {lang === 'fa' ? 'لینک بازیابی معتبر نیست' : 'Invalid or Expired Reset Token'}
          </h2>
          <p className={styles.subtitle}>
            {lang === 'fa'
              ? 'لطفاً مجدداً از صفحه فراموشی رمز عبور درخواست دهید.'
              : 'Please request a new password reset link.'}
          </p>
          <Link to="/auth/forgot-password" className="owj-btn owj-btn--lime">
            {lang === 'fa' ? 'درخواست مجدد لینک' : 'Forgot Password'}
          </Link>
        </div>
      </PageTransition>
    );
  }

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setLoading(true);
    try {
      await authService.resetPassword({ token, password, confirmPassword });
      showToast({
        title: lang === 'fa' ? 'رمز عبور با موفقیت تغییر یافت' : 'Password Reset Complete',
        type: 'success',
      });
      navigate('/auth/login');
    } catch (err) {
      if (err.message === 'PASSWORD_MISMATCH') {
        setError(lang === 'fa' ? 'رمز عبور و تکرار آن مطابقت ندارند.' : 'Passwords do not match.');
      } else if (err.message === 'WEAK_PASSWORD') {
        setError(
          lang === 'fa'
            ? 'رمز عبور باید حداقل ۸ کاراکتر شامل حروف و عدد باشد.'
            : 'Choose a stronger password (min 8 chars + numbers).'
        );
      } else {
        navigate('/auth/error');
      }
    } finally {
      setLoading(false);
    }
  };

  return (
    <PageTransition>
      <div className={styles.card}>
        <h2 className={styles.title}>
          {lang === 'fa' ? 'تعیین رمز عبور جدید' : 'Set New Password'}
        </h2>
        <p className={styles.subtitle}>
          {lang === 'fa'
            ? 'رمز عبور جدید و ایمن برای حساب اوجیفای خود انتخاب کنید.'
            : 'Choose a strong new password for your OWJIFY account.'}
        </p>

        {error && <div className={styles.errorAlert}>{error}</div>}

        <form className={styles.form} onSubmit={handleSubmit}>
          <div className={styles.field}>
            <label>{lang === 'fa' ? 'رمز عبور جدید' : 'New Password'}</label>
            <input
              type="password"
              required
              dir="ltr"
              value={password}
              onChange={(e) => setPassword(e.target.value)}
            />
            <PasswordStrength password={password} />
          </div>

          <div className={styles.field}>
            <label>{lang === 'fa' ? 'تکرار رمز عبور جدید' : 'Confirm New Password'}</label>
            <input
              type="password"
              required
              dir="ltr"
              value={confirmPassword}
              onChange={(e) => setConfirmPassword(e.target.value)}
            />
          </div>

          <button type="submit" disabled={loading} className="owj-btn owj-btn--lime">
            {loading ? <span className="owj-spinner" /> : <ShieldCheck size={17} />}
            <span>{lang === 'fa' ? 'ذخیره رمز جدید' : 'Reset Password'}</span>
          </button>
        </form>
      </div>
    </PageTransition>
  );
}
</file>

<file path="src/pages/Auth/SignUpPage.jsx">
import { useState } from 'react';
import { Link, useNavigate, useSearchParams } from 'react-router-dom';
import { Grid } from '@mui/material';
import { UserPlus } from 'lucide-react';
import PageTransition from '../../components/common/PageTransition';
import PasswordStrength from '../../components/forms/PasswordStrength';
import { useLanguage } from '../../context/LanguageContext';
import { useAuth } from '../../context/AuthContext';
import { useToast } from '../../context/ToastContext';
import styles from './AuthPages.module.scss';

export default function SignUpPage() {
  const { lang } = useLanguage();
  const { register } = useAuth();
  const { showToast } = useToast();
  const navigate = useNavigate();
  const [searchParams] = useSearchParams();

  const [fullName, setFullName] = useState('');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [accountType, setAccountType] = useState(
    searchParams.get('role') === 'professional' ? 'professional' : 'customer'
  );
  const [acceptTerms, setAcceptTerms] = useState(false);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const mapError = (code) => {
    const dict = {
      INVALID_NAME:
        lang === 'fa' ? 'نام و نام خانوادگی معتبر وارد کنید.' : 'Enter your full name.',
      INVALID_EMAIL:
        lang === 'fa' ? 'فرمت نشانی ایمیل صحیح نیست.' : 'Invalid email format.',
      WEAK_PASSWORD:
        lang === 'fa'
          ? 'رمز عبور باید حداقل ۸ کاراکتر و ترکیبی از حروف و اعداد باشد.'
          : 'Password must be at least 8 characters with mixed letters/numbers.',
      PASSWORD_MISMATCH:
        lang === 'fa' ? 'رمز عبور و تکرار آن یکسان نیستند.' : 'Passwords do not match.',
      TERMS_REQUIRED:
        lang === 'fa'
          ? 'پذیرش قوانین و مقررات الزامی است.'
          : 'Please accept the Terms & Conditions.',
      DUPLICATE_EMAIL:
        lang === 'fa'
          ? 'این ایمیل قبلاً در اوجیفای ثبت شده است.'
          : 'An account with this email already exists.',
    };
    return dict[code] || (lang === 'fa' ? 'خطا در ثبت‌نام.' : 'Registration failed.');
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setLoading(true);
    try {
      await register({
        fullName,
        email,
        password,
        confirmPassword,
        accountType,
        acceptTerms,
      });
      showToast({
        title: lang === 'fa' ? 'کد تایید ایمیل ایجاد شد' : 'Verification Code Sent',
        type: 'info',
      });
      navigate('/auth/verify-email');
    } catch (err) {
      setError(mapError(err.message));
    } finally {
      setLoading(false);
    }
  };

  return (
    <PageTransition>
      <div className={styles.card}>
        <h2 className={styles.title}>
          {lang === 'fa' ? 'عضویت در اوجیفای' : 'Create your OWJIFY account'}
        </h2>
        <p className={styles.subtitle}>
          {lang === 'fa'
            ? 'نوع حساب خود را انتخاب کرده و در کمتر از یک دقیقه شروع کنید.'
            : 'Choose your role to start hiring or offering specialist services.'}
        </p>

        {error && <div className={styles.errorAlert}>{error}</div>}

        <form className={styles.form} onSubmit={handleSubmit}>
          <div className={styles.field}>
            <label>{lang === 'fa' ? 'نوع حساب کاربری' : 'Account Type'}</label>
            <Grid container spacing={1}>
              <Grid size={{ xs: 12, sm: 6 }}>
                <button
                  type="button"
                  onClick={() => setAccountType('customer')}
                  className={`${styles.roleOption} ${
                    accountType === 'customer' ? styles.roleActive : ''
                  }`}
                  style={{ width: '100%' }}
                >
                  {lang === 'fa' ? 'کارفرما / مشتری' : 'Customer'}
                </button>
              </Grid>
              <Grid size={{ xs: 12, sm: 6 }}>
                <button
                  type="button"
                  onClick={() => setAccountType('professional')}
                  className={`${styles.roleOption} ${
                    accountType === 'professional' ? styles.roleActive : ''
                  }`}
                  style={{ width: '100%' }}
                >
                  {lang === 'fa' ? 'متخصص / ارائه‌دهنده' : 'Professional'}
                </button>
              </Grid>
            </Grid>
          </div>

          <div className={styles.field}>
            <label>{lang === 'fa' ? 'نام و نام خانوادگی' : 'Full Name'}</label>
            <input
              type="text"
              required
              value={fullName}
              onChange={(e) => setFullName(e.target.value)}
              placeholder={lang === 'fa' ? 'مثلاً: مریم راد' : 'e.g. Maryam Rad'}
