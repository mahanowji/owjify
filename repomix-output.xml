import { useState, useMemo } from 'react';
import { Link, useParams, useNavigate } from 'react-router-dom';
import { Container, Grid, Stack, Tooltip, Chip } from '@mui/material';
import {
  Star,
  MapPin,
  Heart,
  Share2,
  Flag,
  BadgeCheck,
  CheckCircle2,
  Clock,
  Eye,
  MessageSquare,
  Edit3,
  LogIn,
  Sparkles,
  ShieldCheck,
  Headset,
  PauseCircle,
  PlayCircle,
  Trash2,
} from 'lucide-react';
import PageTransition from '../../components/common/PageTransition';
import SmartImage from '../../components/common/SmartImage';
import Modal from '../../components/common/Modal';
import ServiceCard from '../../components/marketplace/ServiceCard';
import ContactModal from '../../components/marketplace/ContactModal';
import ShareModal from '../../components/marketplace/ShareModal';
import ReportModal from '../../components/marketplace/ReportModal';
import { getCategoryById } from '../../data/categories';
import { getLocationById } from '../../data/locations';
import { useLanguage } from '../../context/LanguageContext';
import { useAuth } from '../../context/AuthContext';
import { useMarketplace } from '../../context/MarketplaceContext';
import { useToast } from '../../context/ToastContext';
import {
  formatPrice,
  formatNumber,
  formatRelativeTime,
  toPersianDigits,
} from '../../utils/formatters';
import styles from './ServiceDetailsPage.module.scss';

export default function ServiceDetailsPage() {
  const { id } = useParams();
  const navigate = useNavigate();
  const { lang, l, ui } = useLanguage();
  const {
    user,
    hasToken,
    isCustomer,
    isProfessional,
    isOperator,
    isAdmin,
    isMarketplaceMember,
  } = useAuth();
  const {
    categories,
    advertisements,
    professionals,
    reviews,
    favoriteAds,
    toggleFavoriteAd,
    updateAdvertisement,
    addReview,
    replyToReview,
    deleteReview,
  } = useMarketplace();
  const { showToast } = useToast();

  const ad = advertisements.find((a) => a.id === id);

  const [activeImgIdx, setActiveImgIdx] = useState(0);
  const [lightboxOpen, setLightboxOpen] = useState(false);
  const [contactOpen, setContactOpen] = useState(false);
  const [shareOpen, setShareOpen] = useState(false);
  const [reportOpen, setReportOpen] = useState(false);

  const [reviewRating, setReviewRating] = useState(5);
  const [reviewText, setReviewText] = useState('');
  const [ownerReplyDrafts, setOwnerReplyDrafts] = useState({});

  const pro = useMemo(() => {
    if (!ad) return null;
    return professionals.find((p) => p.id === ad.proId) || professionals[0];
  }, [ad, professionals]);

  const adReviews = useMemo(() => {
    if (!ad) return [];
    return reviews.filter((r) => r.adId === ad.id || r.proId === ad.proId);
  }, [ad, reviews]);

  const relatedAds = useMemo(() => {
    if (!ad) return [];
    return advertisements
      .filter(
        (item) =>
          item.id !== ad.id && item.categoryId === ad.categoryId && item.status === 'active'
      )
      .slice(0, 3);
