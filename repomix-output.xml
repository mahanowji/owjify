                            {l(m.text)}
                          </Typography>
                        </Box>
                      );
                    })}
                  </Stack>

                  {/* User Follow-up Input */}
                  {activeTicket.status !== 'resolved' && (
                    <form onSubmit={handleFollowUp}>
                      <Stack direction="row" spacing={1} alignItems="center">
                        <input
                          value={followUpText}
                          onChange={(e) => setFollowUpText(e.target.value)}
