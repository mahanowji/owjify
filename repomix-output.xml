  @include mobile {
    grid-template-columns: 1fr;
  }
}

.whyCard {
  @include card-dark;
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;

  &:hover {
    border-color: rgba(199, 243, 107, 0.45);
    transform: translateY(-4px);
  }
}

.whyIcon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  @include flex-center;
  background: rgba(199, 243, 107, 0.14);
  color: $lime-400;
}

// Stats & Testimonials
.statsRow {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
  margin-bottom: 3rem;

  @include tablet {
    grid-template-columns: repeat(2, 1fr);
  }
}

.statBox {
  @include card-light;
  padding: 1.75rem;
  text-align: center;
}

.statBig {
  font-size: clamp(2rem, 3.2vw, 2.85rem);
  font-weight: 900;
  color: $charcoal-900;
}

.reviewCard {
  @include card-light;
  padding: 1.65rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

// Join Pro CTA Banner
.proCtaBanner {
  background: $lime-400;
  color: $charcoal-900;
  border-radius: $radius-xl;
  padding: clamp(2.2rem, 5vw, 4rem);
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: 2rem;
  align-items: center;

  @include tablet {
    grid-template-columns: 1fr;
  }
}

// Newsletter
.newsletterBox {
  @include card-dark;
  border-radius: $radius-xl;
  padding: clamp(2rem, 4vw, 3.25rem);
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
