  const handleFav = () => {
    if (!isMarketplaceMember) return;
    const added = toggleFavoritePro(pro.id);
    showToast({
      title: added
        ? lang === 'fa'
          ? 'متخصص ذخیره شد'
          : 'Specialist Saved'
