                </p>

                <Stack direction="row" spacing={0.8} flexWrap="wrap" useFlexGap>
                  {(cat.subcategories || []).map((sub) => (
                    <Link
                      key={sub.id}
                      to={`/explore?category=${cat.id}&subcategory=${sub.id}`}
                      className={styles.subPill}
                    >
                      {l(sub.name)}
                    </Link>
                  ))}
                </Stack>
              </div>
            </Grid>
          ))}
        </Grid>
      </Container>
    </PageTransition>
  );
}
</file>

