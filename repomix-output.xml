import { motion } from 'framer-motion';
import { Heart, Star, MapPin, BadgeCheck, ArrowUpLeft, ArrowUpRight } from 'lucide-react';
import SmartImage from '../common/SmartImage';
import { getCategoryById } from '../../data/categories';
import { getLocationById } from '../../data/locations';
import { useLanguage } from '../../context/LanguageContext';
import { useAuth } from '../../context/AuthContext';
import { useMarketplace } from '../../context/MarketplaceContext';
import { useToast } from '../../context/ToastContext';
import { useMotionSafe } from '../../hooks/useMotionSafe';
import { formatPrice, formatNumber, toPersianDigits } from '../../utils/formatters';
import styles from './ServiceCard.module.scss';

export default function ServiceCard({ ad, viewMode = 'grid' }) {
  const { lang, isRTL, l, ui } = useLanguage();
  const { isMarketplaceMember } = useAuth();
  const { categories, professionals, favoriteAds, toggleFavoriteAd } = useMarketplace();
  const { showToast } = useToast();
  const { prefersReduced } = useMotionSafe();

  const pro = professionals.find((p) => p.id === ad.proId) || professionals[0];
  const category =
    categories.find((c) => c.id === ad.categoryId) || getCategoryById(ad.categoryId);
  const location = getLocationById(ad.locationId);
  const isFav = isMarketplaceMember && favoriteAds.includes(ad.id);

  const handleToggleFav = (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (!isMarketplaceMember) return;
    const added = toggleFavoriteAd(ad.id);
    showToast({
      title: added
        ? lang === 'fa'
          ? 'به علاقه‌مندی‌ها اضافه شد'
          : 'Saved to Favorites'
        : lang === 'fa'
        ? 'از علاقه‌مندی‌ها حذف شد'
        : 'Removed from Favorites',
      message: l(ad.title),
      type: added ? 'success' : 'info',
      duration: 2400,
    });
  };

  const ArrowIcon = isRTL ? ArrowUpLeft : ArrowUpRight;
  const ratingText = lang === 'fa' ? toPersianDigits(ad.rating) : ad.rating;

  return (
    <motion.article
      className={`${styles.card} ${viewMode === 'list' ? styles.listMode : ''}`}
      whileHover={prefersReduced ? undefined : { y: -5 }}
      transition={{ duration: 0.24, ease: [0.22, 1, 0.36, 1] }}
    >
      <div className={styles.coverWrap}>
        <Link to={`/services/${ad.id}`} className={styles.coverMedia}>
          <SmartImage src={ad.images?.[0]} alt={l(ad.title)} />
        </Link>

        <div className={styles.topBadges}>
          <span className={styles.catBadge}>{l(category.name)}</span>
          {ad.urgentAvailable && (
            <span className={styles.urgentBadge}>
              {lang === 'fa' ? 'پاسخ فوری' : 'Express'}
            </span>
          )}
        </div>

        {/* Favorites strictly for Customer & Professional roles */}
        {isMarketplaceMember && (
          <motion.button
            type="button"
            whileTap={prefersReduced ? undefined : { scale: 0.88 }}
            className={`${styles.favBtn} ${isFav ? styles.favActive : ''}`}
            onClick={handleToggleFav}
            aria-label={isFav ? ui.common.saved : ui.common.save}
          >
            <Heart size={14} fill={isFav ? 'currentColor' : 'none'} />
          </motion.button>
        )}
      </div>

      <div className={styles.body}>
        <div className={styles.proRow}>
          <Link to={`/professionals/${pro?.id}`} className={styles.proLink}>
            <span className={styles.proAvatar}>
              <SmartImage src={pro?.avatar} alt={l(pro?.name)} />
            </span>
            <span className={styles.proName}>{l(pro?.name)}</span>
            {pro?.verified && <BadgeCheck size={15} color="#289e67" />}
          </Link>

          <div className={styles.ratingBox}>
            <Star size={13} fill="#E59934" color="#E59934" />
            <span>{ratingText}</span>
            <span className={styles.revCount}>({formatNumber(ad.reviewCount, lang)})</span>
          </div>
        </div>

        <Link to={`/services/${ad.id}`} className={styles.titleLink}>
          {l(ad.title)}
        </Link>

        <p className={styles.shortDesc}>{l(ad.shortDesc)}</p>

        <div className={styles.metaRow}>
          <span className={styles.metaItem}>
            <MapPin size={14} />
            {l(location.name)}
          </span>
          {ad.remoteAvailable && (
            <span className={styles.metaItem}>
              • {lang === 'fa' ? 'امکان دورکاری' : 'Remote OK'}
            </span>
          )}
        </div>

        <div className={styles.footer}>
          <div>
            <span className={styles.priceLabel}>{ui.common.startingFrom}</span>
            <span className={styles.priceVal}>{formatPrice(ad, lang)}</span>
          </div>

          <Link to={`/services/${ad.id}`} className={styles.detailsBtn}>
            <span>{ui.common.viewDetails}</span>
            <ArrowIcon size={15} />
          </Link>
        </div>
      </div>
    </motion.article>
  );
}
</file>

<file path="src/components/marketplace/ShareModal.jsx">
import { useState } from 'react';
import { Copy, Check, ExternalLink } from 'lucide-react';
import Modal from '../common/Modal';
import { useLanguage } from '../../context/LanguageContext';
import { useToast } from '../../context/ToastContext';

export default function ShareModal({ isOpen, onClose, title, shareUrl }) {
  const { lang } = useLanguage();
  const { showToast } = useToast();
  const [copied, setCopied] = useState(false);

  const url =
    shareUrl || (typeof window !== 'undefined' ? window.location.href : 'https://owjify.ir');

  const handleCopy = async () => {
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      // fallback ignored
    }
    setCopied(true);
    showToast({
      title: lang === 'fa' ? 'لینک در کلیپ‌بورد کپی شد' : 'Link Copied',
      type: 'success',
      duration: 2200,
    });
    setTimeout(() => setCopied(false), 2000);
  };

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={lang === 'fa' ? 'اشتراک‌گذاری در شبکه‌ها' : 'Share Link'}
    >
      <p style={{ fontSize: '0.9rem', color: '#464841', marginBottom: '1rem' }}>{title}</p>
      <div
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: '0.5rem',
          padding: '0.6rem 0.75rem',
          background: '#FFFFFF',
          borderRadius: '12px',
          border: '1px solid rgba(17,18,15,0.14)',
          direction: 'ltr',
        }}
      >
        <input
          type="text"
          readOnly
          value={url}
          style={{
            flex: 1,
            border: 'none',
            background: 'transparent',
            fontSize: '0.82rem',
            outline: 'none',
          }}
        />
        <button type="button" onClick={handleCopy} className="owj-btn owj-btn--dark owj-btn--sm">
          {copied ? <Check size={15} /> : <Copy size={15} />}
          <span>{copied ? (lang === 'fa' ? 'کپی شد' : 'Copied') : lang === 'fa' ? 'کپی لینک' : 'Copy'}</span>
        </button>
      </div>

      <div style={{ display: 'flex', gap: '0.6rem', marginTop: '1.1rem', flexWrap: 'wrap' }}>
        <a
          href={`https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title || 'OWJIFY')}`}
          target="_blank"
          rel="noreferrer"
          className="owj-btn owj-btn--outline owj-btn--sm"
        >
          <span>Telegram</span>
          <ExternalLink size={14} />
        </a>
        <a
          href={`https://wa.me/?text=${encodeURIComponent(`${title || 'OWJIFY'} - ${url}`)}`}
          target="_blank"
          rel="noreferrer"
          className="owj-btn owj-btn--outline owj-btn--sm"
        >
          <span>WhatsApp</span>
          <ExternalLink size={14} />
        </a>
        <a
          href={`mailto:?subject=${encodeURIComponent(title || 'OWJIFY')}&body=${encodeURIComponent(url)}`}
          className="owj-btn owj-btn--outline owj-btn--sm"
        >
          <span>Email</span>
          <ExternalLink size={14} />
        </a>
      </div>
    </Modal>
  );
}
</file>

<file path="src/components/marketplace/SkillRequestModal.jsx">
import { useState, useEffect, useMemo } from 'react';
import { useNavigate } from 'react-router-dom';
import { Grid, Stack, Chip, Box } from '@mui/material';
import { Sparkles, Send, Users, Award } from 'lucide-react';
import Modal from '../common/Modal';
import { CATEGORIES } from '../../data/categories';
import { useLanguage } from '../../context/LanguageContext';
import { useAuth } from '../../context/AuthContext';
import { useMarketplace } from '../../context/MarketplaceContext';
import { useToast } from '../../context/ToastContext';

export default function SkillRequestModal() {
  const { lang, l } = useLanguage();
  const { user, hasToken, isProfessional, isMarketplaceMember } = useAuth();
  const {
    activeCategories,
    professionals,
    skillModalState,
    closeSkillRequestModal,
    createSkillRequest,
  } = useMarketplace();
  const { showToast } = useToast();
  const navigate = useNavigate();

  const { open, presetPro } = skillModalState;

  const [requestType, setRequestType] = useState('specialist_collaboration');
  const [categoryId, setCategoryId] = useState('technology');
  const [skillName, setSkillName] = useState('');
  const [targetProId, setTargetProId] = useState('');
  const [urgency, setUrgency] = useState('normal');
  const [budget, setBudget] = useState('');
  const [details, setDetails] = useState('');
  const [addToMyProfile, setAddToMyProfile] = useState(true);
  const [submitting, setSubmitting] = useState(false);

  const otherProfessionals = useMemo(
    () => professionals.filter((p) => p.id !== user?.proId),
    [professionals, user?.proId]
  );

  useEffect(() => {
    if (open) {
      if (presetPro) {
        setRequestType('specialist_collaboration');
        setTargetProId(presetPro.id);
        setCategoryId(presetPro.categoryId || 'technology');
        const firstSkill = presetPro.skills?.[0] ? l(presetPro.skills[0]) : '';
        setSkillName(firstSkill);
      } else {
        const defaultTarget = otherProfessionals[0]?.id || '';
        setTargetProId(defaultTarget);
      }
    }
  }, [open, presetPro, otherProfessionals, l]);

  if (!hasToken || !isMarketplaceMember) return null;

  const activeCategory =
    activeCategories.find((c) => c.id === categoryId) ||
    activeCategories[0] ||
    CATEGORIES[0];

  const suggestedSkills = (activeCategory?.subcategories || []).map((sub) =>
    l(sub.name)
  );

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!skillName.trim()) return;

    setSubmitting(true);
    setTimeout(() => {
      const created = createSkillRequest({
        requestType,
        categoryId,
        skillName: skillName.trim(),
        targetProId,
        urgency,
        budget,
        details: details.trim(),
        addToMyProfile,
      });

      setSubmitting(false);
      setSkillName('');
      setDetails('');
      setBudget('');
      closeSkillRequestModal();

      showToast({
        title:
          lang === 'fa'
            ? 'درخواست مهارت با موفقیت ارسال شد'
            : 'Skill Request Submitted',
        message:
          requestType === 'specialist_collaboration'
            ? lang === 'fa'
              ? 'این درخواست در بخش «پیام‌های ارسالی» و «درخواست‌های مهارت» شما ثبت شد.'
              : 'Saved in your Sent Messages and Skill Requests tab.'
            : lang === 'fa'
            ? 'پیشنهاد مهارت جدید در پنل تخصصی شما ثبت گردید.'
            : 'New skill request logged in your Provider Dashboard.',
        type: 'success',
      });

      if (created.conversationId) {
        navigate(`/messages?conv=${created.conversationId}`);
      } else {
        navigate('/dashboard?tab=skill-requests');
      }
    }, 320);
  };

  const inputStyle = {
    width: '100%',
    padding: '0.78rem 0.95rem',
    borderRadius: '12px',
    border: '1px solid rgba(17,18,15,0.16)',
    background: '#FFFFFF',
    fontSize: '0.9rem',
  };

  return (
    <Modal
      isOpen={open}
      onClose={closeSkillRequestModal}
      title={
        isProfessional
          ? lang === 'fa'
            ? 'ارسال درخواست مهارت و همکاری تخصصی'
            : 'Send a Skill Request (Provider Tool)'
          : lang === 'fa'
          ? 'ثبت درخواست مهارت سفارشی'
          : 'Request a Custom Skill'
      }
      wide
    >
      {/* Mode Selector */}
      <Grid container spacing={1.2} sx={{ mb: 2.2 }}>
        <Grid size={{ xs: 12, sm: 6 }}>
          <button
            type="button"
            onClick={() => setRequestType('specialist_collaboration')}
            style={{
              width: '100%',
              padding: '0.78rem 0.95rem',
              borderRadius: '14px',
              border:
                requestType === 'specialist_collaboration'
                  ? '2px solid #11120F'
                  : '1px solid rgba(17,18,15,0.12)',
              background:
                requestType === 'specialist_collaboration' ? '#11120F' : '#FFFFFF',
              color:
                requestType === 'specialist_collaboration' ? '#C7F36B' : '#11120F',
              fontWeight: 800,
              fontSize: '0.84rem',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              gap: '0.5rem',
            }}
          >
            <Users size={16} />
            <span>
              {lang === 'fa'
                ? 'درخواست مهارت از متخصص دیگر'
                : 'Request Skill from Specialist'}
            </span>
          </button>
        </Grid>

        <Grid size={{ xs: 12, sm: 6 }}>
          <button
            type="button"
            onClick={() => setRequestType('platform_skill')}
            style={{
              width: '100%',
              padding: '0.78rem 0.95rem',
              borderRadius: '14px',
              border:
                requestType === 'platform_skill'
                  ? '2px solid #11120F'
                  : '1px solid rgba(17,18,15,0.12)',
              background:
                requestType === 'platform_skill' ? '#11120F' : '#FFFFFF',
              color: requestType === 'platform_skill' ? '#C7F36B' : '#11120F',
              fontWeight: 800,
              fontSize: '0.84rem',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              gap: '0.5rem',
            }}
          >
            <Award size={16} />
            <span>
              {lang === 'fa'
                ? 'درخواست افزودن مهارت جدید به پلتفرم'
                : 'Request New Platform Skill'}
            </span>
          </button>
        </Grid>
      </Grid>

      <form onSubmit={handleSubmit}>
        <Grid container spacing={2}>
          <Grid size={{ xs: 12, sm: 6 }}>
            <label
              style={{
                display: 'block',
                fontSize: '0.82rem',
                fontWeight: 800,
                marginBottom: 6,
              }}
            >
              {lang === 'fa' ? 'حوزه تخصصی' : 'Discipline / Category'}
            </label>
            <select
              value={categoryId}
              onChange={(e) => setCategoryId(e.target.value)}
              style={inputStyle}
            >
              {activeCategories.map((cat) => (
                <option key={cat.id} value={cat.id}>
                  {l(cat.name)}
                </option>
              ))}
            </select>
          </Grid>

          {requestType === 'specialist_collaboration' ? (
            <Grid size={{ xs: 12, sm: 6 }}>
              <label
                style={{
                  display: 'block',
                  fontSize: '0.82rem',
                  fontWeight: 800,
                  marginBottom: 6,
                }}
              >
                {lang === 'fa' ? 'ارسال به متخصص منتخب' : 'Target Specialist'}
              </label>
              <select
                value={targetProId}
                onChange={(e) => setTargetProId(e.target.value)}
                style={inputStyle}
              >
                {otherProfessionals.map((pro) => (
                  <option key={pro.id} value={pro.id}>
                    {l(pro.name)} — {l(pro.title)}
                  </option>
                ))}
              </select>
            </Grid>
          ) : isProfessional ? (
            <Grid size={{ xs: 12, sm: 6 }} sx={{ display: 'flex', alignItems: 'flex-end' }}>
              <label
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 8,
                  padding: '0.78rem 0.9rem',
                  borderRadius: '12px',
                  background: '#FFFFFF',
                  border: '1px solid rgba(17,18,15,0.12)',
                  width: '100%',
                  fontSize: '0.82rem',
                  fontWeight: 700,
                  cursor: 'pointer',
                }}
              >
                <input
                  type="checkbox"
                  checked={addToMyProfile}
                  onChange={(e) => setAddToMyProfile(e.target.checked)}
                />
                <span>
                  {lang === 'fa'
                    ? 'افزودن هم‌زمان به پروفایل تخصصی من'
                    : 'Also add to my Specialist Profile'}
                </span>
              </label>
            </Grid>
          ) : null}

          <Grid size={{ xs: 12 }}>
            <label
              style={{
                display: 'block',
                fontSize: '0.82rem',
                fontWeight: 800,
                marginBottom: 6,
              }}
            >
              {lang === 'fa' ? 'عنوان مهارت موردنیاز *' : 'Requested Skill Name *'}
            </label>
            <input
              type="text"
              required
              value={skillName}
              onChange={(e) => setSkillName(e.target.value)}
              placeholder={
                lang === 'fa'
                  ? 'مثلاً: طراحی داشبورد IoT، محاسبات سازه، عکاسی معماری...'
                  : 'e.g. IoT Dashboard Engineering, BIM Modeling, Architectural Photo...'
              }
              style={inputStyle}
            />

            {suggestedSkills.length > 0 && (
              <Box sx={{ mt: 1 }}>
                <span style={{ fontSize: '0.75rem', color: '#666860', display: 'block', marginBottom: 4 }}>
                  {lang === 'fa' ? 'انتخاب سریع مهارت‌های پیشنهادی:' : 'Suggested skills:'}
                </span>
                <Stack direction="row" spacing={0.7} flexWrap="wrap" useFlexGap>
                  {suggestedSkills.map((sk) => (
                    <Chip
                      key={sk}
                      label={sk}
                      size="small"
                      onClick={() => setSkillName(sk)}
                      sx={{
                        cursor: 'pointer',
                        bgcolor: skillName === sk ? '#C7F36B' : '#FFFFFF',
                        fontWeight: 700,
                        border: '1px solid rgba(17,18,15,0.12)',
                      }}
                    />
                  ))}
                </Stack>
              </Box>
            )}
          </Grid>

          {requestType === 'specialist_collaboration' && (
            <>
              <Grid size={{ xs: 12, sm: 6 }}>
                <label
                  style={{
                    display: 'block',
                    fontSize: '0.82rem',
                    fontWeight: 800,
                    marginBottom: 6,
                  }}
                >
                  {lang === 'fa' ? 'اولویت زمانی' : 'Urgency'}
                </label>
                <select
                  value={urgency}
                  onChange={(e) => setUrgency(e.target.value)}
                  style={inputStyle}
                >
                  <option value="normal">
                    {lang === 'fa' ? 'هماهنگی عادی پروژه' : 'Standard Schedule'}
                  </option>
                  <option value="urgent">
                    {lang === 'fa' ? 'فوری / اولویت بالا' : 'Urgent / Express'}
                  </option>
                </select>
              </Grid>

              <Grid size={{ xs: 12, sm: 6 }}>
                <label
                  style={{
                    display: 'block',
                    fontSize: '0.82rem',
                    fontWeight: 800,
                    marginBottom: 6,
                  }}
                >
                  {lang === 'fa'
                    ? 'بودجه پیشنهادی همکاری (تومان - اختیاری)'
                    : 'Estimated Collaboration Budget (Optional)'}
                </label>
                <input
                  type="number"
                  min="0"
                  value={budget}
                  onChange={(e) => setBudget(e.target.value)}
                  placeholder={lang === 'fa' ? 'مثلاً: 15000000' : 'e.g. 15000000'}
                  style={inputStyle}
                />
              </Grid>
            </>
          )}

          <Grid size={{ xs: 12 }}>
            <label
              style={{
                display: 'block',
                fontSize: '0.82rem',
                fontWeight: 800,
                marginBottom: 6,
              }}
            >
              {lang === 'fa'
                ? 'شرح نیاز مهارتی و جزئیات همکاری'
                : 'Skill Scope & Collaboration Notes'}
            </label>
            <textarea
              rows={3}
              required
              value={details}
              onChange={(e) => setDetails(e.target.value)}
              placeholder={
                requestType === 'specialist_collaboration'
                  ? lang === 'fa'
                    ? 'توضیح دهید برای کدام بخش از پروژه به این مهارت نیاز دارید و زمان‌بندی مدنظرتان چیست...'
                    : 'Describe what skill deliverables you need from this specialist and your timeline...'
                  : lang === 'fa'
                  ? 'دلیل نیاز به ثبت این مهارت تخصصی جدید در دسته‌بندی‌های اوجیفای را بنویسید...'
                  : 'Explain why this specialized skill should be added to OWJIFY categories...'
              }
              style={{ ...inputStyle, resize: 'vertical' }}
            />
          </Grid>
        </Grid>

        <Stack direction="row" justifyContent="flex-end" spacing={1.2} sx={{ mt: 2.5 }}>
          <button
            type="button"
            onClick={closeSkillRequestModal}
            className="owj-btn owj-btn--outline owj-btn--sm"
          >
            {lang === 'fa' ? 'انصراف' : 'Cancel'}
          </button>
          <button
            type="submit"
            disabled={submitting || !skillName.trim()}
            className="owj-btn owj-btn--lime owj-btn--sm"
          >
            {submitting ? <span className="owj-spinner" /> : <Sparkles size={15} />}
            <span>
              {requestType === 'specialist_collaboration'
                ? lang === 'fa'
                  ? 'ارسال درخواست مهارت و آغاز گفتگو'
                  : 'Send Skill Request & Message'
                : lang === 'fa'
                ? 'ثبت درخواست مهارت جدید'
                : 'Submit Skill Request'}
            </span>
          </button>
        </Stack>
      </form>
    </Modal>
  );
}
</file>

<file path="src/components/messaging/ChatThread.jsx">
import { useState, useEffect, useRef } from 'react';
import { Link } from 'react-router-dom';
import { Stack, Chip } from '@mui/material';
import { Send, MessageSquare, ArrowRight, ArrowLeft } from 'lucide-react';
import SmartImage from '../common/SmartImage';
import { useLanguage } from '../../context/LanguageContext';
import { useAuth } from '../../context/AuthContext';
import { formatTimeClock } from '../../utils/formatters';
import styles from './ChatThread.module.scss';

export default function ChatThread({ conversation, onSend, onMobileBack }) {
  const { lang, isRTL, l } = useLanguage();
  const { isProfessional } = useAuth();
  const [draft, setDraft] = useState('');
  const areaRef = useRef(null);

  useEffect(() => {
    if (areaRef.current) {
      areaRef.current.scrollTop = areaRef.current.scrollHeight;
    }
  }, [conversation?.id, conversation?.messages?.length]);

  if (!conversation) {
    return (
      <div className={styles.emptyState}>
        <MessageSquare size={38} />
        <h3>
          {lang === 'fa' ? 'یک گفتگو را برای نمایش انتخاب کنید' : 'Select a conversation'}
        </h3>
        <p style={{ fontSize: '0.86rem', maxWidth: 340 }}>
          {isProfessional
            ? lang === 'fa'
              ? 'پیام‌های دریافتی شما و درخواست‌هایی که به سایر متخصصان ارسال کرده‌اید در اینجا قابل مشاهده است.'
              : 'View your incoming inquiries alongside requests you sent to other specialists.'
            : lang === 'fa'
            ? 'پیام‌ها و استعلام‌هایی که برای متخصصان ارسال کرده‌اید در این بخش نمایش داده می‌شود.'
            : 'View the messages and inquiries you have sent to OWJIFY specialists.'}
        </p>
      </div>
    );
  }

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!draft.trim()) return;
    onSend(conversation.id, draft);
    setDraft('');
  };

  const BackIcon = isRTL ? ArrowRight : ArrowLeft;
  const isIncoming = conversation.direction === 'received';

  const badgeLabel = isIncoming
    ? lang === 'fa'
      ? 'پیام دریافتی متخصص'
      : 'Received Inquiry'
    : isProfessional
    ? lang === 'fa'
      ? 'درخواست من به متخصص دیگر'
      : 'Request to Specialist'
    : lang === 'fa'
    ? 'ارسالی به متخصص'
    : 'Sent to Specialist';

  return (
    <div className={styles.chatPane}>
      <div className={styles.header}>
        <div className={styles.person}>
          {onMobileBack && (
            <button
              type="button"
              onClick={onMobileBack}
              className="owj-btn owj-btn--ghost owj-btn--sm"
              aria-label="Back to list"
            >
              <BackIcon size={17} />
            </button>
          )}
          <div className={styles.avatar}>
            <SmartImage
              src={conversation.participantAvatar}
              alt={l(conversation.participantName)}
            />
          </div>
          <div>
            <Stack direction="row" spacing={0.8} alignItems="center" flexWrap="wrap" useFlexGap>
              <span className={styles.name}>{l(conversation.participantName)}</span>
              <Chip
                size="small"
                label={badgeLabel}
                sx={{
                  height: 22,
                  fontSize: '0.7rem',
                  fontWeight: 800,
                  bgcolor: isIncoming
                    ? 'rgba(40, 158, 103, 0.14)'
                    : isProfessional
                    ? '#C7F36B'
                    : 'rgba(17, 18, 15, 0.08)',
                  color: isIncoming ? '#1e7e50' : '#11120F',
                }}
              />
            </Stack>
            <div className={styles.serviceSub}>{l(conversation.serviceTitle)}</div>
          </div>
        </div>

        {conversation.proId ? (
          <Link
            to={`/professionals/${conversation.proId}`}
            className="owj-btn owj-btn--outline owj-btn--sm"
          >
            {lang === 'fa' ? 'پروفایل متخصص' : 'View Profile'}
          </Link>
        ) : (
          <span
            style={{
              fontSize: '0.76rem',
              fontWeight: 700,
              color: '#666860',
              padding: '0.35rem 0.75rem',
              borderRadius: 999,
              background: '#F6F5F0',
            }}
          >
            {l(conversation.participantRole) ||
              (lang === 'fa' ? 'کاربر متقاضی' : 'Client')}
          </span>
        )}
      </div>

      <div className={styles.messagesArea} ref={areaRef}>
        {(conversation.messages || []).length === 0 ? (
          <p
            style={{
              textAlign: 'center',
              color: '#92948c',
              marginTop: '2rem',
              fontSize: '0.88rem',
            }}
          >
            {lang === 'fa'
              ? 'اولین پیام خود را برای شروع گفتگو بنویسید...'
              : 'Send your first message to start the conversation...'}
          </p>
        ) : (
          conversation.messages.map((msg) => (
            <div
              key={msg.id}
              className={`${styles.bubbleRow} ${
                msg.sender === 'me' ? styles.mine : styles.theirs
              }`}
            >
              <div className={styles.bubble}>{l(msg.text)}</div>
              <span className={styles.time}>{formatTimeClock(msg.createdAt, lang)}</span>
            </div>
          ))
        )}
      </div>

      <form className={styles.composer} onSubmit={handleSubmit}>
        <input
          type="text"
          className={styles.input}
          value={draft}
          onChange={(e) => setDraft(e.target.value)}
          placeholder={
            isIncoming
              ? lang === 'fa'
                ? 'پاسخ خود را بنویسید...'
                : 'Write your reply...'
              : lang === 'fa'
              ? 'پیام خود را بنویسید و Enter بزنید...'
              : 'Write a message...'
          }
        />
        <button
          type="submit"
          disabled={!draft.trim()}
          className="owj-btn owj-btn--lime owj-btn--sm"
        >
          <Send size={15} />
          <span>{lang === 'fa' ? 'ارسال' : 'Send'}</span>
        </button>
      </form>
    </div>
  );
}
</file>

