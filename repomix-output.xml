}

.catCount {
  font-size: 0.76rem;
  font-weight: 700;
  color: $gray-500;
  margin-top: 0.85rem;
}

// Grids for Pros & Ads
.cardsGrid3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
