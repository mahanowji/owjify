            </ProtectedRoute>
          }
        />

        {/* Customer & Provider Workspace Routes (Admin -> /admin, Operator -> /operator) */}
        <Route
          path="/dashboard"
          element={
            <ProtectedRoute requireRole={['customer', 'professional']}>
              <DashboardPage />
            </ProtectedRoute>
          }
        />
        <Route
          path="/messages"
          element={
            <ProtectedRoute requireRole={['customer', 'professional']}>
              <MessagesPage />
            </ProtectedRoute>
          }
        />
        <Route
          path="/notifications"
          element={
            <ProtectedRoute requireRole={['customer', 'professional']}>
              <NotificationsPage />
            </ProtectedRoute>
          }
        />
        <Route
          path="/favorites"
          element={
            <ProtectedRoute requireRole={['customer', 'professional']}>
              <FavoritesPage />
            </ProtectedRoute>
          }
        />
        <Route
          path="/saved"
          element={
            <ProtectedRoute requireRole={['customer', 'professional']}>
              <FavoritesPage />
            </ProtectedRoute>
          }
        />

        {/* Shared Authenticated Account Routes */}
        <Route
          path="/settings"
          element={
            <ProtectedRoute>
              <SettingsPage />
            </ProtectedRoute>
          }
        />
        <Route
          path="/profile/edit"
          element={
            <ProtectedRoute>
              <EditProfilePage />
            </ProtectedRoute>
          }
        />

        {/* Public Static & Legal Pages */}
        <Route path="/about" element={<AboutPage />} />
        <Route path="/contact" element={<ContactPage />} />
        <Route path="/help" element={<HelpFaqPage />} />
        <Route path="/faq" element={<HelpFaqPage />} />
        <Route path="/terms" element={<TermsPage />} />
        <Route path="/privacy" element={<PrivacyPage />} />

        {/* Convenience Redirects */}
        <Route path="/login" element={<Navigate to="/auth/login" replace />} />
        <Route path="/signup" element={<Navigate to="/auth/signup" replace />} />
        <Route path="/register" element={<Navigate to="/auth/signup" replace />} />

        {/* 404 Not Found */}
        <Route path="*" element={<NotFoundPage />} />
      </Route>

      {/* Authentication Split-Screen Shell */}
      <Route path="/auth" element={<AuthLayout />}>
        <Route index element={<Navigate to="/auth/login" replace />} />
        <Route path="login" element={<LoginPage />} />
        <Route path="signup" element={<SignUpPage />} />
        <Route path="register" element={<SignUpPage />} />
        <Route path="forgot-password" element={<ForgotPasswordPage />} />
        <Route path="reset-password" element={<ResetPasswordPage />} />
        <Route path="verify-email" element={<VerifyEmailPage />} />
        <Route path="verify-success" element={<VerifySuccessPage />} />
        <Route path="error" element={<AuthErrorPage />} />
      </Route>
    </Routes>
  );
}
