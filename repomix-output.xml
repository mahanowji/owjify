  font-weight: 700;
  background: $white;
  border: 1px solid rgba(17, 18, 15, 0.1);
  color: $gray-700;
  transition: all 0.2s ease;

  &.tabActive {
    background: $charcoal-900;
    color: $lime-400;
    border-color: $charcoal-900;
  }
}

// How It Works
.stepsGrid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;

  @include mobile {
    grid-template-columns: 1fr;
  }
