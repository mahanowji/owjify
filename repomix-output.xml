                      ? 'پیگیری گزارش‌ها و پاسخ اپراتور'
                      : 'Track Tickets & Operator Answers'}
                  </Typography>
                </Stack>
              </Stack>

              {/* Lookup by Tracking Code */}
              <Box
                sx={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 1,
                  px: 1.4,
                  py: 0.7,
                  borderRadius: 2.5,
                  bgcolor: '#F6F5F0',
                  border: '1px solid rgba(17,18,15,0.1)',
                  mb: 2,
                }}
              >
                <Search size={16} color="#666860" />
                <input
                  dir="ltr"
                  value={lookupQuery}
                  onChange={(e) => {
                    setLookupQuery(e.target.value);
                    setSelectedTicketId(e.target.value);
                  }}
                  placeholder={
                    lang === 'fa'
                      ? 'جستجو با کد پیگیری (مثال: SUP-1041)'
                      : 'Enter Tracking ID (e.g. SUP-1041)'
                  }
                  style={{
                    flex: 1,
                    border: 'none',
                    outline: 'none',
                    background: 'transparent',
                    fontSize: '0.84rem',
                  }}
                />
