                          >
                            <CheckCircle2 size={13} color="#C7F36B" />
                            <span>{lang === 'fa' ? 'بستن پرونده' : 'Resolve'}</span>
                          </button>
                        )}
                      </Stack>
                    </Stack>

                    <Typography sx={{ fontWeight: 800, fontSize: '0.94rem', mb: 0.6 }}>
                      {l(t.subject)}
                    </Typography>

                    {t.escalationReason && (
