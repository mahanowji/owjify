  @include tablet {
    grid-template-columns: repeat(2, 1fr);
  }

  @include mobile {
    grid-template-columns: 1fr;
  }
}

.cardsGrid4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;

  @include tablet {
    grid-template-columns: repeat(2, 1fr);
  }

  @include mobile {
    grid-template-columns: 1fr;
  }
}

.filterTabs {
