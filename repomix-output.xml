  align-items: center;
  background: $charcoal-900;

  @include tablet {
    grid-template-columns: 1fr;
  }
}

.newsletterForm {
  display: flex;
  gap: 0.6rem;

  @include small-mobile {
    flex-direction: column;
  }

  input {
    flex: 1;
    padding: 0.9rem 1.15rem;
    border-radius: $radius-pill;
    border: 1px solid rgba(246, 245, 240, 0.2);
    background: rgba(246, 245, 240, 0.07);
    color: $offwhite-100;
    outline: none;

    &:focus {
      border-color: $lime-400;
    }
  }
}
