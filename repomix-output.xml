                    </Grid>
                    <Grid size={{ xs: 6 }}>
                      <div style={{ color: '#666860' }}>
                        {lang === 'fa' ? 'پروژه‌های موفق' : 'Completed'}
                      </div>
                      <strong>{formatNumber(pro.completedJobs, lang)}</strong>
                    </Grid>
                  </Grid>

                  <Link
                    to={`/professionals/${pro.id}`}
                    className="owj-btn owj-btn--outline"
                    style={{ width: '100%', marginTop: '1rem' }}
                  >
                    {ui.common.viewProfile}
                  </Link>
                </div>
              )}
            </aside>
          </Grid>
        </Grid>

        {/* Related Services */}
        {relatedAds.length > 0 && (
          <section style={{ marginTop: '4rem' }}>
            <h2 style={{ fontSize: '1.5rem', fontWeight: 900, marginBottom: '1.5rem' }}>
              {lang === 'fa' ? 'خدمات مشابه در این دسته‌بندی' : 'Related Services'}
            </h2>
            <Grid container spacing={2.5}>
              {relatedAds.map((rel) => (
                <Grid key={rel.id} size={{ xs: 12, sm: 6, lg: 4 }}>
                  <ServiceCard ad={rel} />
                </Grid>
              ))}
            </Grid>
          </section>
        )}
      </Container>

      {/* Image Lightbox */}
      <Modal
        isOpen={lightboxOpen}
        onClose={() => setLightboxOpen(false)}
        title={l(ad.title)}
        wide
      >
        <div style={{ borderRadius: '16px', overflow: 'hidden', maxHeight: '70vh' }}>
          <SmartImage src={currentImg} alt={l(ad.title)} />
        </div>
      </Modal>

      {isMarketplaceMember && (
        <ContactModal
          isOpen={contactOpen}
          onClose={() => setContactOpen(false)}
          pro={pro}
          serviceTitle={ad.title}
        />
      )}

      <ReportModal
        isOpen={reportOpen}
        onClose={() => setReportOpen(false)}
        adId={ad.id}
        adTitle={l(ad.title)}
      />

      <ShareModal
        isOpen={shareOpen}
        onClose={() => setShareOpen(false)}
        title={l(ad.title)}
      />
    </PageTransition>
  );
}
</file>

<file path="src/pages/Settings/EditProfilePage.jsx">
import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { Container, Grid, Stack, Chip } from '@mui/material';
import { Save, Upload, Plus } from 'lucide-react';
import PageTransition from '../../components/common/PageTransition';
import SmartImage from '../../components/common/SmartImage';
import { LOCATIONS } from '../../data/locations';
import { useLanguage } from '../../context/LanguageContext';
import { useAuth } from '../../context/AuthContext';
import { useMarketplace } from '../../context/MarketplaceContext';
import { useToast } from '../../context/ToastContext';
import styles from './SettingsPages.module.scss';

export default function EditProfilePage() {
  const { lang, l } = useLanguage();
  const { user, isProfessional, isAdmin, isOperator, updateProfile } = useAuth();
  const { syncUserToProfessional } = useMarketplace();
  const { showToast } = useToast();
  const navigate = useNavigate();

  const [dirty, setDirty] = useState(false);
  const [fullName, setFullName] = useState(() => l(user?.fullName || ''));
  const [title, setTitle] = useState(() => l(user?.title || ''));
  const [locationId, setLocationId] = useState(user?.locationId || 'tehran');
  const [experienceYears, setExperienceYears] = useState(user?.experienceYears || 5);
  const [bio, setBio] = useState(() => l(user?.bio || ''));
  const [avatar, setAvatar] = useState(user?.avatar || '');
  const [skills, setSkills] = useState(() => (user?.skills || []).map((s) => l(s)));
  const [skillInput, setSkillInput] = useState('');
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    if (!dirty && user) {
      setFullName(l(user.fullName || ''));
      setTitle(l(user.title || ''));
      setBio(l(user.bio || ''));
      setSkills((user.skills || []).map((s) => l(s)));
    }
  }, [lang, user, dirty, l]);

  const handleAvatarFile = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      if (typeof reader.result === 'string') {
        setDirty(true);
        setAvatar(reader.result);
      }
    };
    reader.readAsDataURL(file);
  };

  const addSkill = () => {
    const clean = skillInput.trim();
    if (!clean || skills.includes(clean)) return;
    setDirty(true);
    setSkills((p) => [...p, clean]);
    setSkillInput('');
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setSaving(true);
    try {
      const updated = await updateProfile({
        fullName,
        title,
        locationId,
        experienceYears: Number(experienceYears),
        bio,
        avatar,
        skills,
      });
      if (isProfessional) {
        syncUserToProfessional(updated);
      }
      showToast({
        title: lang === 'fa' ? 'پروفایل شما با موفقیت ذخیره شد' : 'Profile Updated',
        type: 'success',
      });
      navigate(isAdmin ? '/admin' : isOperator ? '/operator' : '/dashboard');
    } finally {
      setSaving(false);
    }
  };

  return (
    <PageTransition>
      <Container maxWidth="md" sx={{ py: { xs: 3, md: 5 }, pb: { xs: 6, md: 9 } }}>
        <h1 style={{ fontSize: 'clamp(1.45rem, 2.5vw, 1.85rem)', fontWeight: 900, marginBottom: '1.4rem' }}>
          {isProfessional
            ? lang === 'fa'
              ? 'ویرایش پروفایل تخصصی و کاربری'
              : 'Edit Specialist Profile'
            : lang === 'fa'
            ? 'ویرایش اطلاعات حساب کاربری'
            : 'Edit Account Profile'}
        </h1>

        <form className={styles.panel} onSubmit={handleSubmit}>
          <Stack direction="row" spacing={2} alignItems="center" flexWrap="wrap" useFlexGap sx={{ mb: 3 }}>
            <div style={{ width: 84, height: 84, borderRadius: 22, overflow: 'hidden', border: '3px solid #C7F36B' }}>
              <SmartImage src={avatar} alt={fullName} />
            </div>
            <label className="owj-btn owj-btn--outline owj-btn--sm" style={{ cursor: 'pointer' }}>
              <Upload size={15} />
              <span>{lang === 'fa' ? 'تغییر تصویر پروفایل' : 'Upload Avatar'}</span>
              <input type="file" accept="image/*" onChange={handleAvatarFile} style={{ display: 'none' }} />
            </label>
          </Stack>

          <Grid container spacing={2} sx={{ mb: 2 }}>
            <Grid size={{ xs: 12, sm: 6 }}>
              <div className={styles.field}>
                <label>{lang === 'fa' ? 'نام و نام خانوادگی' : 'Full Name'}</label>
                <input
                  type="text"
                  required
                  value={fullName}
                  onChange={(e) => {
                    setDirty(true);
                    setFullName(e.target.value);
                  }}
                />
              </div>
            </Grid>

            {isProfessional && (
              <Grid size={{ xs: 12, sm: 6 }}>
                <div className={styles.field}>
                  <label>{lang === 'fa' ? 'عنوان شغلی / تخصص' : 'Professional Headline'}</label>
                  <input
                    type="text"
                    value={title}
                    onChange={(e) => {
                      setDirty(true);
                      setTitle(e.target.value);
                    }}
                  />
                </div>
              </Grid>
            )}

            <Grid size={{ xs: 12, sm: 6 }}>
              <div className={styles.field}>
                <label>{lang === 'fa' ? 'شهر' : 'City'}</label>
                <select
                  value={locationId}
                  onChange={(e) => {
                    setDirty(true);
                    setLocationId(e.target.value);
                  }}
                >
                  {LOCATIONS.map((locItem) => (
                    <option key={locItem.id} value={locItem.id}>
                      {l(locItem.name)}
                    </option>
                  ))}
                </select>
              </div>
            </Grid>

            {isProfessional && (
              <Grid size={{ xs: 12, sm: 6 }}>
                <div className={styles.field}>
                  <label>{lang === 'fa' ? 'سابقه فعالیت (سال)' : 'Years of Experience'}</label>
                  <input
                    type="number"
                    min="1"
                    max="45"
                    value={experienceYears}
                    onChange={(e) => {
                      setDirty(true);
                      setExperienceYears(e.target.value);
                    }}
                  />
                </div>
              </Grid>
            )}
          </Grid>

          <div className={styles.field}>
            <label>
              {isProfessional
                ? lang === 'fa'
                  ? 'درباره من و سوابق اجرایی'
                  : 'About & Specialist Bio'
                : lang === 'fa'
                ? 'درباره من / معرفی کوتاه'
                : 'Short Bio'}
            </label>
            <textarea
              rows={4}
              value={bio}
              onChange={(e) => {
                setDirty(true);
                setBio(e.target.value);
              }}
            />
          </div>

          {isProfessional && (
            <div className={styles.field}>
              <label>{lang === 'fa' ? 'مهارت‌های تخصصی' : 'Skills'}</label>
              <Stack direction="row" spacing={1}>
                <input
                  type="text"
                  style={{ flex: 1 }}
                  value={skillInput}
                  onChange={(e) => setSkillInput(e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === 'Enter') {
                      e.preventDefault();
                      addSkill();
                    }
                  }}
                  placeholder={lang === 'fa' ? 'افزودن مهارت جدید...' : 'Add skill...'}
                />
                <button
                  type="button"
                  onClick={addSkill}
                  className="owj-btn owj-btn--dark owj-btn--sm"
                >
                  <Plus size={15} />
                </button>
              </Stack>

              <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap sx={{ mt: 1.5 }}>
                {skills.map((sk) => (
                  <Chip
                    key={sk}
                    label={sk}
                    onDelete={() => {
                      setDirty(true);
                      setSkills((p) => p.filter((item) => item !== sk));
                    }}
                    color="primary"
                    size="small"
                  />
                ))}
              </Stack>
            </div>
          )}

          <Stack direction="row" justifyContent="flex-end" spacing={1.2} sx={{ mt: 3 }}>
            <button
              type="button"
              onClick={() => navigate(-1)}
              className="owj-btn owj-btn--outline"
            >
              {lang === 'fa' ? 'انصراف' : 'Cancel'}
            </button>
            <button type="submit" disabled={saving} className="owj-btn owj-btn--lime">
              {saving ? <span className="owj-spinner" /> : <Save size={16} />}
              <span>{lang === 'fa' ? 'ذخیره تغییرات' : 'Save Profile'}</span>
            </button>
          </Stack>
        </form>
      </Container>
    </PageTransition>
  );
}
</file>

<file path="src/pages/Settings/SettingsPage.jsx">
import { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { Container, Grid, Stack, Switch } from '@mui/material';
import { Globe, ShieldCheck, RotateCcw, LogOut } from 'lucide-react';
import PageTransition from '../../components/common/PageTransition';
import PasswordStrength from '../../components/forms/PasswordStrength';
import { STORAGE_KEYS, readStorage, writeStorage, clearAllDemoStorage } from '../../utils/storage';
import { useLanguage } from '../../context/LanguageContext';
import { useAuth } from '../../context/AuthContext';
import { useToast } from '../../context/ToastContext';
import styles from './SettingsPages.module.scss';

export default function SettingsPage() {
  const { lang, setLang } = useLanguage();
  const { user, changePassword, updateProfile, logout } = useAuth();
  const { showToast } = useToast();
  const navigate = useNavigate();

  const [prefs, setPrefs] = useState(() =>
    readStorage(STORAGE_KEYS.SETTINGS, {
      emailAlerts: true,
      messageAlerts: true,
      reviewAlerts: true,
    })
  );

  const [currentPassword, setCurrentPassword] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [passLoading, setPassLoading] = useState(false);

  const togglePref = (key) => {
    const next = { ...prefs, [key]: !prefs[key] };
    setPrefs(next);
    writeStorage(STORAGE_KEYS.SETTINGS, next);
    showToast({
      title: lang === 'fa' ? 'تنظیمات اعلان ذخیره شد' : 'Notification Preferences Saved',
      type: 'success',
      duration: 2000,
    });
  };

  const handlePasswordChange = async (e) => {
    e.preventDefault();
    setPassLoading(true);
    try {
      await changePassword({ currentPassword, newPassword });
      setCurrentPassword('');
      setNewPassword('');
      showToast({
        title: lang === 'fa' ? 'رمز عبور با موفقیت تغییر یافت' : 'Password Changed',
        type: 'success',
      });
    } catch (err) {
      showToast({
        title:
          err.message === 'WRONG_CURRENT_PASSWORD'
            ? lang === 'fa'
              ? 'رمز عبور فعلی نادرست است'
              : 'Current password is incorrect'
            : lang === 'fa'
            ? 'رمز عبور جدید باید قوی‌تر باشد'
            : 'Please choose a stronger password',
        type: 'error',
      });
    } finally {
      setPassLoading(false);
    }
  };

  const handleRoleSwitch = async (role) => {
    await updateProfile({ accountType: role });
    showToast({
      title:
        lang === 'fa'
          ? 'نوع حساب کاربری به‌روزرسانی شد'
          : 'Account Role Updated',
      type: 'success',
    });
  };

  const handleResetDemo = () => {
    clearAllDemoStorage();
    window.location.href = '/';
  };

  return (
    <PageTransition>
      <Container maxWidth="md" sx={{ py: { xs: 3, md: 5 }, pb: { xs: 6, md: 9 } }}>
        <Stack
          direction={{ xs: 'column', sm: 'row' }}
          justifyContent="space-between"
          alignItems={{ xs: 'flex-start', sm: 'center' }}
          spacing={1.5}
          sx={{ mb: 3 }}
        >
          <h1 style={{ fontSize: 'clamp(1.45rem, 2.5vw, 1.85rem)', fontWeight: 900 }}>
            {lang === 'fa' ? 'تنظیمات حساب کاربری' : 'Account Settings'}
          </h1>
          <Link to="/profile/edit" className="owj-btn owj-btn--dark owj-btn--sm">
            {lang === 'fa' ? 'ویرایش اطلاعات پروفایل' : 'Edit Profile'}
          </Link>
        </Stack>

        <Grid container spacing={2.5} sx={{ mb: 2.5 }}>
          {/* Language & Direction */}
          <Grid size={{ xs: 12, md: 6 }}>
            <div className={styles.panel} style={{ height: '100%', marginBottom: 0 }}>
              <h2 className={styles.secTitle}>
                <Globe size={18} style={{ display: 'inline', marginInlineEnd: 6 }} />
                {lang === 'fa' ? 'زبان رابط کاربری و جهت چیدمان' : 'Interface Language & Layout'}
              </h2>
              <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap>
                <button
                  type="button"
                  onClick={() => setLang('fa')}
                  className={`owj-btn ${lang === 'fa' ? 'owj-btn--lime' : 'owj-btn--outline'} owj-btn--sm`}
                >
                  فارسی (RTL)
                </button>
                <button
                  type="button"
                  onClick={() => setLang('en')}
                  className={`owj-btn ${lang === 'en' ? 'owj-btn--lime' : 'owj-btn--outline'} owj-btn--sm`}
                >
                  English (LTR)
                </button>
              </Stack>
            </div>
          </Grid>

          {/* Account Role */}
          <Grid size={{ xs: 12, md: 6 }}>
            <div className={styles.panel} style={{ height: '100%', marginBottom: 0 }}>
              <h2 className={styles.secTitle}>
                {lang === 'fa' ? 'نقش حساب در اوجیفای' : 'Marketplace Account Type'}
              </h2>
              {user?.accountType === 'admin' || user?.accountType === 'operator' ? (
                <div
                  style={{
                    display: 'inline-flex',
                    alignItems: 'center',
                    gap: '0.5rem',
                    padding: '0.45rem 0.9rem',
                    borderRadius: '999px',
                    background: '#11120F',
                    color: '#C7F36B',
                    fontSize: '0.82rem',
                    fontWeight: 800,
                  }}
                >
                  <ShieldCheck size={15} />
                  <span>
                    {user?.accountType === 'admin'
                      ? lang === 'fa'
                        ? 'مدیر ارشد سامانه (Admin & CRM)'
                        : 'Platform Administrator (Admin & CRM)'
                      : lang === 'fa'
                      ? 'اپراتور پشتیبانی (Support Operator)'
                      : 'Support Operator'}
                  </span>
                </div>
              ) : (
                <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap>
                  <button
                    type="button"
                    onClick={() => handleRoleSwitch('customer')}
                    className={`owj-btn ${
                      user?.accountType === 'customer' ? 'owj-btn--dark' : 'owj-btn--outline'
                    } owj-btn--sm`}
                  >
                    {lang === 'fa' ? 'کارفرما / مشتری' : 'Customer'}
                  </button>
                  <button
                    type="button"
                    onClick={() => handleRoleSwitch('professional')}
                    className={`owj-btn ${
                      user?.accountType === 'professional' ? 'owj-btn--dark' : 'owj-btn--outline'
                    } owj-btn--sm`}
                  >
                    {lang === 'fa' ? 'متخصص / ارائه‌دهنده' : 'Professional'}
                  </button>
                </Stack>
              )}
            </div>
          </Grid>
        </Grid>

        {/* Notifications */}
        <div className={styles.panel}>
          <h2 className={styles.secTitle}>
            {lang === 'fa' ? 'تنظیمات دریافت اعلان‌ها' : 'Notification Preferences'}
          </h2>
          <Stack spacing={1}>
            {[
              {
                key: 'messageAlerts',
                fa: 'اعلان پیام‌های مستقیم جدید',
                en: 'Direct message notifications',
              },
              {
                key: 'reviewAlerts',
                fa: 'اعلان ثبت امتیاز و دیدگاه مشتریان',
                en: 'New client review alerts',
              },
              {
                key: 'emailAlerts',
                fa: 'خبرنامه و گزارش عملکرد هفتگی',
                en: 'Weekly performance digest',
              },
            ].map((item) => (
              <Stack
                key={item.key}
                direction="row"
                justifyContent="space-between"
                alignItems="center"
              >
                <span style={{ fontWeight: 600, fontSize: '0.92rem' }}>{item[lang]}</span>
                <Switch
                  checked={Boolean(prefs[item.key])}
                  onChange={() => togglePref(item.key)}
                  color="primary"
                />
              </Stack>
            ))}
          </Stack>
        </div>

        {/* Security / Change Password */}
        <div className={styles.panel}>
          <h2 className={styles.secTitle}>
            <ShieldCheck size={18} style={{ display: 'inline', marginInlineEnd: 6 }} />
            {lang === 'fa' ? 'امنیت و تغییر رمز عبور' : 'Change Password'}
          </h2>
          <form onSubmit={handlePasswordChange}>
            <Grid container spacing={2} sx={{ mb: 1.5 }}>
              <Grid size={{ xs: 12, sm: 6 }}>
                <div className={styles.field}>
                  <label>{lang === 'fa' ? 'رمز عبور فعلی' : 'Current Password'}</label>
                  <input
                    type="password"
                    required
                    dir="ltr"
                    value={currentPassword}
                    onChange={(e) => setCurrentPassword(e.target.value)}
                  />
                </div>
              </Grid>
              <Grid size={{ xs: 12, sm: 6 }}>
                <div className={styles.field}>
                  <label>{lang === 'fa' ? 'رمز عبور جدید' : 'New Password'}</label>
                  <input
                    type="password"
                    required
                    dir="ltr"
                    value={newPassword}
                    onChange={(e) => setNewPassword(e.target.value)}
                  />
                </div>
              </Grid>
            </Grid>
            <PasswordStrength password={newPassword} />
            <button
              type="submit"
              disabled={passLoading}
              className="owj-btn owj-btn--dark owj-btn--sm"
              style={{ marginTop: '0.75rem' }}
            >
              {lang === 'fa' ? 'به‌روزرسانی رمز عبور' : 'Update Password'}
            </button>
          </form>
        </div>

        {/* Demo Reset & Sign Out */}
        <div className={styles.panel}>
          <Stack
            direction={{ xs: 'column', sm: 'row' }}
            justifyContent="space-between"
            spacing={1.5}
          >
            <button
              type="button"
              onClick={handleResetDemo}
              className="owj-btn owj-btn--outline owj-btn--sm"
            >
              <RotateCcw size={15} />
              <span>
                {lang === 'fa' ? 'بازگردانی داده‌های نمایشی اولیه' : 'Reset Demo Data'}
              </span>
            </button>

            <button
              type="button"
              onClick={() => {
                logout();
                navigate('/');
              }}
              className="owj-btn owj-btn--danger owj-btn--sm"
            >
              <LogOut size={15} />
              <span>{lang === 'fa' ? 'خروج از حساب کاربری' : 'Sign Out'}</span>
            </button>
          </Stack>
        </div>
      </Container>
    </PageTransition>
  );
}
</file>

<file path="src/pages/Static/CategoriesPage.jsx">
